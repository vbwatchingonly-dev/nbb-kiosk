        ];

        // Drink Choices (Photo 7 - Zero drinks included)
        const drinkOptions = [
            { id: 'd_pepsi_zero', name: '펩시제로 M', priceDiff: 0, icon: '🥤' },
            { id: 'd_brand_zero', name: '브랜드콜라 제로', priceDiff: 0, icon: '🥤' },
            { id: 'd_cider_zero', name: '브랜드사이다 제로', priceDiff: 0, icon: '🥤' },
            { id: 'd_tams_zero', name: '탐스제로 오렌지', priceDiff: 0, icon: '🥤' },
            { id: 'd_pepsi', name: '펩시콜라 M', priceDiff: 0, icon: '🥤' },
            { id: 'd_cider', name: '사이다 M', priceDiff: 0, icon: '🥤' },
            { id: 'd_lemonade', name: '레몬에이드', priceDiff: 800, icon: '🍹' },
            { id: 'd_americano', name: '아메리카노(HOT)', priceDiff: 500, icon: '☕' }
        ];

        /* ===================================================================
           INITIALIZATION & RENDER FUNCTIONS
           =================================================================== */

        window.onload = function() {
            renderCategories();
            renderMenuGrid();
            renderCart();
        };

        function goToMenuScreen() {
            document.getElementById('screenWelcome').classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                document.getElementById('screenWelcome').classList.add('hidden');
            }, 300);
        }

        function resetOrder() {
            state.cart = [];
            renderCart();
            document.getElementById('screenComplete').classList.add('hidden');
            document.getElementById('screenWelcome').classList.remove('hidden', 'opacity-0', 'pointer-events-none');
        }

        function toggleDiningOption() {
            playTouchSound();
            if (state.diningOption === '매장 식사') {
                state.diningOption = '포장하기';
            } else {
                state.diningOption = '매장 식사';
            }
            document.getElementById('diningOptionBadge').innerText = state.diningOption;
            document.getElementById('completeDiningType').innerText = state.diningOption;
        }

        function renderCategories() {
            const nav = document.getElementById('categoryNav');
            nav.innerHTML = categories.map(cat => `
                <button onclick="playTouchSound(); switchCategory('${cat.id}')" 
                        class="py-2.5 px-0.5 transition-all text-[11px] truncate ${state.activeCategory === cat.id ? 'bg-nbb-yellow text-nbb-black font-extrabold border-b-2 border-nbb-black' : 'text-gray-300 hover:text-white'}">
                    ${cat.name}
                </button>
            `).join('');
        }

        function switchCategory(catId) {
            state.activeCategory = catId;
            renderCategories();
            renderMenuGrid();
        }

        function renderMenuGrid() {
            const grid = document.getElementById('menuGrid');
            const items = menuDatabase[state.activeCategory] || menuDatabase.recommend;

            // Render 'only NBB' tab special view (Salads + Hamburger Combo)
            if (state.activeCategory === 'only_nbb') {
                grid.innerHTML = items.map(item => `
                    <div onclick="playTouchSound(); selectSaladItem('${item.id}')" class="touch-active bg-white rounded-xl p-2 shadow-sm border border-gray-200 flex flex-col justify-between relative cursor-pointer hover:border-nbb-yellow transition">
                        ${item.badge ? `<span class="absolute top-1 left-1 z-10 bg-nbb-accent text-white text-[8px] font-black px-1.5 py-0.5 rounded">${item.badge}</span>` : ''}
                        
                        <div class="w-full h-20 mb-1 overflow-hidden rounded-lg bg-gray-100 flex items-center justify-center">
                            <img src="${item.img}" class="w-full h-full object-cover" style="${item.demoNutrition ? 'object-fit:contain;background:#fff' : ''}">
                        </div>

                        <div>
                            <h4 class="font-bold text-xs text-gray-900 leading-tight">${item.name}</h4>
                            <p class="text-[8px] text-gray-400 mt-0.5 line-clamp-1">${item.desc}</p>${saladNutritionMarkup(item)}
                        </div>

                        <div class="mt-1.5 pt-1 border-t border-gray-100 flex flex-col gap-0.5">
                            <div class="text-[9px] text-gray-600 font-bold">단품: <span class="text-black">${item.priceSingle.toLocaleString()}원</span></div>
                            <div class="text-[9px] text-red-600 font-black">세트: ${item.priceCombo.toLocaleString()}원~</div>
                        </div>
                    </div>
                `).join('');

                // Top banner button in 'only NBB' for Special Combo
                grid.insertAdjacentHTML('afterbegin', `
                    <div onclick="playTouchSound(); selectSaladItem('s_chicken')" class="col-span-3 bg-gradient-to-r from-yellow-300 via-amber-200 to-yellow-400 p-2 rounded-xl border-2 border-nbb-black flex items-center justify-between cursor-pointer shadow-sm">
                        <div class="flex items-center gap-2">
                            <div class="text-2xl">🥗🍔🥤</div>
                            <div>
                                <span class="bg-nbb-black text-nbb-yellow text-[8px] font-bold px-1.5 py-0.5 rounded">only NBB 특가 세트</span>
                                <div class="font-black text-xs text-nbb-black leading-tight">햄버거 + 샐러드 + 제로음료 콤보</div>
                                <div class="text-[9px] text-gray-700">신선한 샐러드와 든든한 버거를 한번에!</div>
                            </div>
                        </div>
                        <span class="bg-nbb-black text-white text-[10px] font-bold px-2.5 py-1 rounded-lg shadow shrink-0">선택하기 &gt;</span>
                    </div>
                `);
                return;
            }

            // Regular Categories Rendering
            grid.innerHTML = items.map(item => `
                <div onclick="playTouchSound(); addRegularItemToCart('${item.id}')" class="touch-active bg-white rounded-xl p-2 shadow-sm border border-gray-200 flex flex-col justify-between relative cursor-pointer hover:border-nbb-yellow transition">
                    ${item.badge ? `<span class="absolute top-1 left-1 z-10 bg-nbb-accent text-white text-[8px] font-black px-1.5 py-0.5 rounded">${item.badge}</span>` : ''}
                    
                    <div class="w-full h-20 mb-1 overflow-hidden rounded-lg bg-gray-100 flex items-center justify-center">
                        <img src="${item.img}" class="w-full h-full object-cover" style="${item.demoNutrition ? 'object-fit:contain;background:#fff' : ''}">
                    </div>

                    <div>
                        <h4 class="font-bold text-xs text-gray-900 leading-tight">${item.name}</h4>
                        <p class="text-[8px] text-gray-400 mt-0.5 line-clamp-1">${item.desc}</p>${saladNutritionMarkup(item)}
                    </div>

                    <div class="mt-1.5 pt-1 border-t border-gray-100 text-right">
                        <span class="text-xs font-black text-red-600">${item.price.toLocaleString()}원</span>
                    </div>
                </div>
            `).join('');
        }

        function addRegularItemToCart(itemId) {
            const categoryItems = menuDatabase[state.activeCategory] || menuDatabase.recommend;
            const item = categoryItems.find(i => i.id === itemId);
            if (!item) return;

            state.cart.push({
                cartItemId: Date.now().toString(),
                name: item.name,
                price: item.price,
                desc: '기본 구성'
            });
            renderCart();
        }

        /* ===================================================================
           MODAL 1: SALAD CLICK -> SINGLE VS COMBO CHOICE (PHOTO 5)
           =================================================================== */

        function selectSaladItem(saladId) {
            const saladList = menuDatabase.only_nbb;
            const salad = saladList.find(s => s.id === saladId) || saladList[0];
            state.selectedSalad = salad;

            document.getElementById('setChoiceSingleImg').src = salad.img;
            document.getElementById('saladDemoNutrition').innerHTML = saladNutritionMarkup(salad);
            document.getElementById('setChoiceSingleTitle').innerText = salad.name;
            document.getElementById('setChoiceSinglePrice').innerText = `${salad.priceSingle.toLocaleString()}원`;

            document.getElementById('setChoiceComboImg').src = salad.img;
            document.getElementById('setChoiceComboTitle').innerText = `${salad.name} 콤보 세트`;
            document.getElementById('setChoiceComboPrice').innerText = `${salad.priceCombo.toLocaleString()}원~`;

            openModal('modalSetChoice');
        }

        function confirmSingleOption() {
            closeModal('modalSetChoice');
            const item = {
                cartItemId: Date.now().toString(),
                name: `${state.selectedSalad.name} (단품)`,
                price: state.selectedSalad.priceSingle,
                desc: '단품 구성'
            };
            state.cart.push(item);
            renderCart();
        }

        /* ===================================================================
           MODAL 2: BURGER SELECTION WITH CALORIES (PHOTO 6)
           =================================================================== */

        function proceedToBurgerSelection() {
            closeModal('modalSetChoice');
            
            state.selectedBurger = burgerOptions[0];

            const container = document.getElementById('burgerListContainer');
            container.innerHTML = burgerOptions.map((burger, idx) => `
                <div onclick="playTouchSound(); selectBurgerOption(${idx})" id="burgerOpt_${idx}" class="burger-opt-card p-2 rounded-xl border-2 ${idx === 0 ? 'border-nbb-yellow bg-amber-50' : 'border-gray-200 bg-white'} cursor-pointer flex justify-between items-center transition">
                    <div>
                        <div class="font-bold text-xs text-gray-900">${burger.name}</div>
                        <div class="text-[9px] text-gray-500 mt-0.5">${burger.desc}</div>
                        <div class="text-[9px] font-bold text-amber-700 mt-0.5">🔥 칼로리: ${burger.kcal}</div>
                    </div>
                    <div class="text-right">
                        <span class="text-xs font-bold text-red-600">${burger.priceDiff > 0 ? `+${burger.priceDiff.toLocaleString()}원` : '추가금 없음'}</span>
                    </div>
                </div>
            `).join('');

            openModal('modalBurgerChoice');
        }

        function selectBurgerOption(index) {
            state.selectedBurger = burgerOptions[index];
            document.querySelectorAll('.burger-opt-card').forEach((card, idx) => {
                if (idx === index) {
                    card.className = 'burger-opt-card p-2 rounded-xl border-2 border-nbb-yellow bg-amber-50 cursor-pointer flex justify-between items-center transition';
                } else {
                    card.className = 'burger-opt-card p-2 rounded-xl border-2 border-gray-200 bg-white cursor-pointer flex justify-between items-center transition';
                }
            });
        }

        /* ===================================================================
           MODAL 3: DRINK SELECTION GRID (PHOTO 7)
           =================================================================== */

        function proceedToDrinkSelection() {
            closeModal('modalBurgerChoice');

            state.selectedDrink = drinkOptions[0];

            const container = document.getElementById('drinkGridContainer');
            container.innerHTML = drinkOptions.map((drink, idx) => `
                <div onclick="playTouchSound(); selectDrinkOption(${idx})" id="drinkOpt_${idx}" class="drink-opt-card p-1.5 rounded-xl border-2 ${idx === 0 ? 'border-nbb-black bg-neutral-900 text-white' : 'border-gray-200 bg-white text-gray-800'} cursor-pointer flex flex-col items-center justify-between text-center transition">
                    <div class="text-xl my-0.5">${drink.icon}</div>
                    <div class="font-bold text-[9px] leading-tight">${drink.name}</div>
                    <div class="text-[8px] font-semibold mt-0.5 text-red-500">${drink.priceDiff > 0 ? `+${drink.priceDiff}원` : '+0원'}</div>
                </div>
            `).join('');

            openModal('modalDrinkChoice');
        }

        function selectDrinkOption(index) {
            state.selectedDrink = drinkOptions[index];
            document.querySelectorAll('.drink-opt-card').forEach((card, idx) => {
                if (idx === index) {
                    card.className = 'drink-opt-card p-1.5 rounded-xl border-2 border-nbb-black bg-neutral-900 text-white cursor-pointer flex flex-col items-center justify-between text-center transition';
                } else {
                    card.className = 'drink-opt-card p-1.5 rounded-xl border-2 border-gray-200 bg-white text-gray-800 cursor-pointer flex flex-col items-center justify-between text-center transition';
                }
            });
        }

        function confirmComboToCart() {
            closeModal('modalDrinkChoice');

            const hasCheese = document.getElementById('toppingCheese').checked;
            const toppingCost = hasCheese ? 500 : 0;

            const totalComboPrice = state.selectedSalad.priceCombo 
                                  + state.selectedBurger.priceDiff 
                                  + state.selectedDrink.priceDiff 
                                  + toppingCost;

            const item = {
                cartItemId: Date.now().toString(),
                name: `${state.selectedSalad.name} 세트`,
                price: totalComboPrice,
                desc: `${state.selectedBurger.name} / ${state.selectedDrink.name}`
            };

            state.cart.push(item);
            renderCart();
        }

        /* ===================================================================
           CART & CHECKOUT HELPERS
           =================================================================== */

        function renderCart() {
            const list = document.getElementById('cartItemList');
            const totalDisplay = document.getElementById('totalPriceDisplay');
            const countBadge = document.getElementById('cartCountBadge');
            const checkoutBtn = document.getElementById('checkoutBtn');

            const totalPrice = state.cart.reduce((sum, item) => sum + item.price, 0);

            countBadge.innerText = `${state.cart.length}개`;
            totalDisplay.innerText = `${totalPrice.toLocaleString()} 원`;
            checkoutBtn.disabled = state.cart.length === 0;

            if (state.cart.length === 0) {
                list.innerHTML = `<div class="w-full flex items-center justify-center text-xs text-gray-400 font-medium">메뉴를 선택해 주세요!</div>`;
                return;
            }

            list.innerHTML = state.cart.map(item => `
                <div class="shrink-0 bg-gray-50 rounded-xl p-2 border border-gray-200 flex items-center gap-2 min-w-[150px] relative">
                    <div class="flex-1 min-w-0">
                        <div class="font-bold text-xs truncate text-gray-800">${item.name}</div>
                        <div class="text-[9px] text-gray-500 truncate">${item.desc}</div>
                        <div class="text-xs font-bold text-red-600 mt-0.5">${item.price.toLocaleString()}원</div>
                    </div>
                    <button onclick="playTouchSound(); removeFromCart('${item.cartItemId}')" class="text-gray-400 hover:text-red-500 p-1 text-xs">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            `).join('');
        }

        function removeFromCart(cartItemId) {
            state.cart = state.cart.filter(i => i.cartItemId !== cartItemId);
            renderCart();
        }

        function clearCart() {
            state.cart = [];
            renderCart();
        }

        function openCheckoutModal() {
            if (state.cart.length === 0) return;
            const summary = document.getElementById('checkoutOrderSummary');
            const totalPrice = state.cart.reduce((sum, item) => sum + item.price, 0);

            summary.innerHTML = state.cart.map(item => `
                <div class="py-2 flex justify-between items-center text-xs">
                    <div>
                        <div class="font-bold text-xs text-gray-900">${item.name}</div>
                        <div class="text-[10px] text-gray-500 mt-0.5">${item.desc}</div>
                    </div>
                    <div class="font-bold text-xs text-red-600">${item.price.toLocaleString()}원</div>
                </div>
            `).join('');

            document.getElementById('checkoutFinalPrice').innerText = `${totalPrice.toLocaleString()} 원`;
            openModal('checkoutModal');
        }

        function processPayment() {
            closeModal('checkoutModal');
            state.orderCounter++;
            const totalPrice = state.cart.reduce((sum, item) => sum + item.price, 0);

            document.getElementById('completedOrderNum').innerText = `#${state.orderCounter}`;
            document.getElementById('completeTotalPrice').innerText = `${totalPrice.toLocaleString()}원`;

            state.cart = [];
            renderCart();

            document.getElementById('screenComplete').classList.remove('hidden');
        }

        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }
    </script>
