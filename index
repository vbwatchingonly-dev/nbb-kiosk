const saladDemoValues={chicken:[230,18],pork:[180,13],avocado:[210,12],green:[45,2],mini:[25,1]};
const saladAssetKeys={s_chicken:'chicken',s_pork:'pork',s_avocado:'avocado',s_green:'green',sal_1:'pork',sal_2:'avocado',sal_3:'chicken',sal_4:'green',sal_5:'mini'};
