 if(!item.demoNutrition)return '';
 return `<div style="font-size:10px;line-height:1.45;margin-top:5px;color:#384438"><b>${item.demoNutrition[0]} kcal</b> · 단백질 <b>${item.demoNutrition[1]} g</b><small style="display:block;font-size:8px;color:#666">시안용 가상 수치 · 실제 영양정보 아님<br>드레싱 제외 가정</small></div>`;
}
</script>
