        // Burger Selections with Calories (Photo 6)
        const burgerOptions = [
            { id: 'b_sig', name: 'NBB 시그니처 버거', kcal: '485 kcal', priceDiff: 0, desc: '직화 미트패티와 치즈의 기본 시그니처' },
