<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>노브랜드 버거 KIOSK</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Noto Sans KR & Black Han Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        nbb: {
                            yellow: '#FFC700',
                            yellowDark: '#E6B200',
                            black: '#111111',
                            dark: '#1C1C1C',
                            gray: '#F4F4F5',
                            accent: '#D92525'
                        }
                    },
                    fontFamily: {
                        sans: ['"Noto Sans KR"', 'sans-serif'],
                        impact: ['"Black Han Sans"', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
            font-family: 'Noto Sans KR', sans-serif;
            background-color: #0d0d0d;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #222;
        }
        ::-webkit-scrollbar-thumb {
            background: #FFC700;
            border-radius: 4px;
        }

        .touch-active:active {
            transform: scale(0.96);
            opacity: 0.9;
        }

        .pulse-subtle {
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }

        .kiosk-frame {
            max-width: 500px;
            height: 940px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85);
        }

        .shimmer {
            background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.3) 50%, rgba(255,255,255,0) 100%);
            background-size: 200% 100%;
            animation: shimmer 2.5s infinite;
        }
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        .chiikawa-bounce {
            animation: chiikawaBounce 2s ease-in-out infinite;
        }
        @keyframes chiikawaBounce {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-6px) scale(1.02); }
        }
    
/* Bright NBB theme: yellow brand areas, white ordering surfaces. */
body {background:#fff7d4!important;color:#171717;}
.kiosk-frame {height:min(940px,100dvh);min-height:640px;border-color:#ffc700!important;box-shadow:0 20px 70px #a9851d26!important;}
#screenWelcome{background:#fffdf5;}
.brand-head{padding:22px 24px;background:#ffc700;display:flex;justify-content:space-between;align-items:center;gap:12px;}
.brand-head b{font-size:25px;line-height:1;letter-spacing:-1px;}.brand-head b span{display:block;}
.brand-head small{font-size:10px;font-weight:900;width:115px;}
.welcome-content{padding:22px 22px 8px;flex:1;}.eyebrow{font-weight:900;font-size:12px;margin-bottom:6px;}
.welcome-content h1{font-weight:900;font-size:32px;line-height:1.25;letter-spacing:-1.3px;margin-bottom:16px;}
.collab-poster{width:100%;border-radius:14px;display:block;}
.welcome-prices{margin-top:16px;}.welcome-prices>div{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #e9dfbc;gap:8px;font-size:12px;font-weight:700;}.welcome-prices strong{font-size:18px;white-space:nowrap;}
.random-info{font-size:12px;font-weight:800;line-height:1.8;margin-top:12px;}.random-info small{font-size:11px;color:#665f46;font-weight:500;}
.start-order{background:#ffc700;margin:8px 22px 0;padding:17px 20px;border-radius:12px;font-size:19px;font-weight:900;display:flex;justify-content:space-between;flex-shrink:0;}.start-order:hover{background:#ffd62d;}.welcome-note{text-align:center;color:#73694b;font-size:10px;padding:9px;}
#kioskContainer>header{background:#fff!important;color:#171717!important;}
#kioskContainer>header>div:nth-child(2){background:#fff2ad!important;color:#171717!important;border-color:#f0d873;}
#kioskContainer>header>div:nth-child(2) .text-yellow-300,#kioskContainer>header>div:nth-child(2) .text-white{color:#171717!important;}
#categoryNav{background:#fff!important;border-color:#eee3bb!important;padding:5px;gap:3px;}
#categoryNav button{color:#514b36!important;border-radius:7px;white-space:normal;}
#categoryNav button:not(.bg-nbb-yellow):hover{background:#fff5c4;}
#menuGridContainer{background:#fffdf5!important;padding:14px;}
#menuGrid{gap:10px;}#menuGrid>div{border-color:#e9e3cf;border-radius:13px;padding:10px;}
#menuGrid h4{font-size:12px;line-height:1.5;}
#menuGrid .text-red-600,#totalPriceDisplay{color:#171717!important;}
#menuGrid img{background:#fff9e6;}
#kioskContainer>footer>div:last-child{background:#fff3c2!important;color:#171717!important;padding:8px;gap:5px;}
#kioskContainer>footer>div:last-child button{background:#fff!important;color:#171717!important;border:1px solid #e4d698;}
#kioskContainer>footer>div:last-child #checkoutBtn{background:#ffc700!important;border-color:#ffc700;}
#kioskContainer>footer>div:last-child #checkoutBtn:disabled{background:#eeeadf!important;color:#9b9585!important;border-color:#eeeadf;}
[id^=modal]>div>div:first-child,#checkoutModal>div>div:first-child{background:#ffc700!important;color:#171717!important;}
[id^=modal] h3,#checkoutModal h3{color:#171717!important;}
.drink-opt-card.bg-neutral-900{background:#fff1aa!important;color:#171717!important;border-color:#ffc700!important;}
::-webkit-scrollbar-track{background:#fff8dc;}::-webkit-scrollbar-thumb{background:#e6b600;}
@media(max-height:760px){.welcome-content{padding-top:12px;}.welcome-content h1{font-size:25px;margin-bottom:10px;}.collab-poster{max-height:245px;object-fit:contain;}.welcome-prices{margin-top:8px;}.welcome-prices>div{padding:6px 0;}.brand-head{padding:14px 22px;}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;}}
</style>
</head>
<body class="bg-neutral-950 text-gray-800 flex justify-center items-center min-h-screen p-0 md:p-4">

    <!-- MAIN KIOSK CONTAINER FRAME -->
    <div id="kioskContainer" class="kiosk-frame w-full bg-white relative flex flex-col overflow-hidden md:rounded-3xl border-0 md:border-8 border-neutral-900 shadow-2xl transition-all duration-300">
        
        <!-- ========================================== -->
        <!-- SCREEN 0: WELCOME COVER SCREEN (EXACT CHIIKAWA POSTER) -->
        <!-- ========================================== -->
        <div id="screenWelcome" class="absolute inset-0 z-30 flex flex-col overflow-y-auto">
          <div class="brand-head"><b>No Brand<span>Burger</span></b><small>WHY PAY MORE? IT’S GOOD ENOUGH.</small></div>
          <section class="welcome-content">
            <p class="eyebrow">NBB × 먼작귀</p>
            <h1>오늘의 한 끼,<br>귀여움은 내 곁에!</h1>
            <img class="collab-poster" src="data:image/png;base64," alt="사용자 제공 노브랜드버거 먼작귀 콜라보 시안">
            <div class="welcome-prices">
              <div><span>시그니처 세트</span><strong>11,100원</strong></div>
              <div><span>메가바이트 버거 세트</span><strong>11,400원</strong></div>
              <div><span>어메이징 더블 업 버거 세트</span><strong>12,200원</strong></div>
            </div>
            <p class="random-info">버거 + 감자튀김 + 탄산음료 + 피규어 랜덤 1종<br><small>랜덤 박스 제공 · 캐릭터 선택 불가</small></p>
          </section>
          <button class="start-order" onclick="playTouchSound(); goToMenuScreen()">주문 시작하기 <span>→</span></button>
          <p class="welcome-note">콜라보 예상 판매가를 적용한 주문 체험</p>
        </div>

        <!-- ========================================== -->
        <!-- MAIN ORDERING INTERFACE (WITH ALL ORIGINAL TABS + only NBB) -->
        <!-- ========================================== -->
        <header class="bg-nbb-black text-white shrink-0 shadow-md relative z-10">
            <!-- Top Utility Line -->
            <div class="bg-nbb-yellow text-nbb-black px-3 py-1 flex justify-between items-center text-xs font-bold">
                <div class="flex items-center gap-2">
                    <button onclick="toggleDiningOption()" id="diningOptionBadge" class="bg-nbb-black text-white px-2 py-0.5 rounded text-[10px] font-black hover:bg-neutral-800">매장 식사</button>
                    <span class="font-extrabold tracking-wide">NO BRAND BURGER</span>
                </div>
                <button onclick="playTouchSound(); resetOrder()" class="hover:underline flex items-center gap-1 text-nbb-black font-extrabold">
                    <i class="fa-solid fa-rotate-left text-xs"></i> 처음으로
                </button>
            </div>

            <!-- Top Promo Banner (NBB 펀치 / NBB 훅 Photo 2 Banner) -->
            <div class="bg-gradient-to-r from-red-700 via-neutral-900 to-red-800 p-2 text-white border-b border-neutral-800 flex items-center justify-between relative overflow-hidden">
                <div class="flex items-center gap-2 z-10">
                    <div class="bg-nbb-yellow text-black font-impact text-xs px-2 py-0.5 rounded shadow">
                        NBB 펀치 X 훅
                    </div>
                    <div>
                        <div class="text-xs font-black leading-tight text-yellow-300">진한 체다에 할라피뇨 한빵! <span class="text-white font-normal">스모키에 단짠까지!</span></div>
                    </div>
                </div>
                <div class="flex gap-1 shrink-0 z-10 text-xl">
                    🍔 🔥
                </div>
            </div>

            <!-- Category Tabs (Includes ALL original tabs + 'only NBB') -->
            <nav class="grid grid-cols-4 bg-neutral-900 text-center text-[11px] font-bold border-b border-neutral-800" id="categoryNav">
                <!-- Injected via JS -->
            </nav>
        </header>

        <!-- MENU GRID CONTAINER -->
        <main class="flex-1 overflow-y-auto p-2.5 bg-neutral-100" id="menuGridContainer">
            <div class="grid grid-cols-3 gap-2" id="menuGrid">
                <!-- Injected via JS -->
            </div>
        </main>

        <!-- CART & CHECKOUT BOTTOM FOOTER -->
        <footer class="bg-white border-t border-gray-200 shadow-2xl shrink-0 z-20">
            <!-- Selected Item Row Header -->
            <div class="px-3 py-1.5 border-b border-gray-100 flex justify-between items-center bg-gray-50">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-gray-700">주문상품</span>
                    <span id="cartCountBadge" class="bg-nbb-yellow text-nbb-black font-black text-xs px-2 py-0.5 rounded-full">0개</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-xs text-gray-500">주문금액</span>
                    <span id="totalPriceDisplay" class="text-sm font-black text-red-600">0 원</span>
                </div>
            </div>

            <!-- Cart Items Horizontal List -->
            <div class="h-16 overflow-x-auto p-2 flex gap-2 no-scrollbar bg-white" id="cartItemList">
                <div class="w-full flex items-center justify-center text-xs text-gray-400 font-medium">
                    메뉴를 선택해 주세요!
                </div>
            </div>

            <!-- Action Buttons Footer -->
            <div class="p-1.5 bg-neutral-900 grid grid-cols-4 gap-1 text-white text-xs font-bold">
                <button onclick="playTouchSound(); alert('영양성분 및 알레르기 유발물질 함유 정보입니다.')" class="bg-neutral-800 hover:bg-neutral-700 py-2.5 rounded text-center border border-neutral-700 text-[10px]">
                    영양성분/알레르기
                </button>
                <button onclick="playTouchSound(); alert('통신사 할인 및 제휴 쿠폰 바코드를 스캔해 주세요.')" class="bg-neutral-800 hover:bg-neutral-700 py-2.5 rounded text-center border border-neutral-700 text-[10px]">
                    통신사/제휴 쿠폰
                </button>
                <button onclick="playTouchSound(); clearCart()" class="bg-neutral-700 hover:bg-neutral-600 py-2.5 rounded text-center text-[10px]">
                    취소
                </button>
                <button id="checkoutBtn" onclick="playTouchSound(); openCheckoutModal()" disabled class="bg-nbb-accent disabled:bg-gray-700 disabled:text-gray-500 text-white font-black py-2.5 rounded text-center text-xs shadow">
                    결제하기
                </button>
            </div>
        </footer>

        <!-- ========================================== -->
        <!-- MODAL 1: SET OPTION POPUP (PHOTO 5) -->
        <!-- ========================================== -->
        <div id="modalSetChoice" class="hidden absolute inset-0 z-40 bg-black/75 backdrop-blur-xs flex items-center justify-center p-3">
            <div class="bg-white w-full max-w-sm rounded-3xl overflow-hidden shadow-2xl border-2 border-nbb-black transform transition-all">
                
                <!-- Popup Header -->
                <div class="bg-nbb-black text-white p-3 text-center relative">
                    <h3 class="text-base font-impact text-nbb-yellow tracking-wide">세트로 드시겠어요?</h3>
                    <button onclick="playTouchSound(); closeModal('modalSetChoice')" class="absolute top-2.5 right-3 text-gray-400 hover:text-white text-lg">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <!-- Choice Options Grid (Photo 5 Requirement) -->
                <div class="p-3 grid grid-cols-2 gap-2.5 bg-gray-50">
                    <!-- Left: Single Option (단품 선택) -->
                    <div onclick="playTouchSound(); confirmSingleOption()" class="touch-active bg-white border-2 border-gray-200 hover:border-nbb-yellow rounded-2xl p-3 flex flex-col items-center text-center shadow-sm cursor-pointer transition">
                        <div class="text-xs font-bold text-gray-600 mb-1">단품 선택</div>
                        <div id="saladDemoNutrition" style="margin-bottom:6px"></div>
                        <img id="setChoiceSingleImg" src="" style="object-fit:contain;border-radius:8px;background:#fff" class="w-20 h-20 object-cover rounded-full mb-1 border border-gray-200">
                        <div id="setChoiceSingleTitle" class="font-bold text-xs text-gray-900 leading-tight">치킨시저샐러드</div>
                        <div id="setChoiceSinglePrice" class="font-black text-xs text-red-600 mt-1">5,200원</div>
                    </div>

                    <!-- Right: Combo Set Option (햄버거 + 샐러드 + 제로음료 콤보) -->
                    <div onclick="playTouchSound(); proceedToBurgerSelection()" class="touch-active bg-amber-50 border-2 border-nbb-yellow rounded-2xl p-3 flex flex-col items-center text-center shadow-md cursor-pointer relative overflow-hidden transition">
                        <span class="absolute top-0 right-0 bg-nbb-accent text-white font-black text-[8px] px-1.5 py-0.5 rounded-bl-lg">BEST COMBO</span>
                        <div class="text-xs font-black text-nbb-black mb-0.5">세트 선택</div>
                        <div class="text-[8px] text-amber-800 font-bold mb-1 bg-amber-200/60 px-1 rounded">햄버거+샐러드+제로음료</div>
                        <div class="relative w-20 h-20 mb-1 flex items-center justify-center">
                            <img id="setChoiceComboImg" src="" style="object-fit:contain;border-radius:8px;background:#fff" class="w-16 h-16 object-cover rounded-full border border-yellow-400 shadow">
                            <span class="absolute bottom-0 right-0 text-base bg-white rounded-full p-0.5 shadow">🥤</span>
                        </div>
                        <div id="setChoiceComboTitle" class="font-bold text-xs text-gray-900 leading-tight">치킨시저 콤보 세트</div>
                        <div id="setChoiceComboPrice" class="font-black text-xs text-red-600 mt-1">6,600원~</div>
                    </div>
                </div>

                <div class="p-2.5 bg-gray-100 text-center border-t border-gray-200">
                    <button onclick="playTouchSound(); closeModal('modalSetChoice')" class="w-full bg-gray-300 text-gray-700 font-bold py-2 rounded-xl text-xs">
                        취소하기
                    </button>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- MODAL 2: BURGER SELECTION & CALORIES (PHOTO 6) -->
        <!-- ========================================== -->
        <div id="modalBurgerChoice" class="hidden absolute inset-0 z-40 bg-black/80 flex items-center justify-center p-3">
            <div class="bg-white w-full max-w-md rounded-2xl overflow-hidden shadow-2xl flex flex-col max-h-[90%] border border-gray-300">
                
                <!-- Modal Header -->
                <div class="bg-neutral-900 text-white p-3 flex justify-between items-center shrink-0">
                    <div>
                        <span class="text-[9px] bg-nbb-yellow text-black font-bold px-1.5 py-0.5 rounded">세트 구성 1단계</span>
                        <h3 class="text-xs font-bold mt-0.5">햄버거를 선택하세요 (칼로리 정보)</h3>
                    </div>
                    <button onclick="playTouchSound(); closeModal('modalBurgerChoice')" class="text-gray-400 text-lg">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <!-- Burger List with Calories -->
                <div class="p-2.5 overflow-y-auto space-y-2 flex-1 bg-gray-50" id="burgerListContainer">
                    <!-- JS Injected Burger Cards -->
                </div>

                <!-- Extra Topping Checkbox Section -->
                <div class="p-2.5 bg-white border-t border-gray-200 shrink-0">
                    <div class="text-xs font-bold text-gray-700 mb-1 flex items-center gap-1">
                        <i class="fa-solid fa-plus text-nbb-yellow"></i> 추가 토핑을 선택하세요
                    </div>
                    <div class="grid grid-cols-2 gap-2 text-xs">
                        <label class="flex items-center gap-2 p-1.5 rounded-lg border border-gray-200 bg-gray-50 cursor-pointer">
                            <input type="checkbox" id="toppingJalapeno" class="rounded text-nbb-yellow focus:ring-0">
                            <span class="text-[11px]">할라피뇨 추가 (+0원)</span>
                        </label>
                        <label class="flex items-center gap-2 p-1.5 rounded-lg border border-gray-200 bg-gray-50 cursor-pointer">
                            <input type="checkbox" id="toppingCheese" class="rounded text-nbb-yellow focus:ring-0">
                            <span class="text-[11px]">치즈 추가 (+500원)</span>
                        </label>
                    </div>
                </div>

                <!-- Footer Nav -->
                <div class="p-2.5 bg-gray-100 flex gap-2 shrink-0 border-t border-gray-200">
                    <button onclick="playTouchSound(); openModal('modalSetChoice'); closeModal('modalBurgerChoice');" class="w-1/3 bg-gray-300 font-bold text-xs py-2 rounded-xl text-gray-700">
                        이전
                    </button>
                    <button onclick="playTouchSound(); proceedToDrinkSelection()" class="w-2/3 bg-nbb-yellow font-black text-xs py-2 rounded-xl text-nbb-black shadow">
                        다음 (음료 선택)
                    </button>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- MODAL 3: DRINK SELECTION GRID (PHOTO 7) -->
        <!-- ========================================== -->
        <div id="modalDrinkChoice" class="hidden absolute inset-0 z-40 bg-black/80 flex items-center justify-center p-3">
            <div class="bg-white w-full max-w-md rounded-2xl overflow-hidden shadow-2xl flex flex-col max-h-[90%] border border-gray-300">
                
                <!-- Modal Header -->
                <div class="bg-neutral-900 text-white p-3 flex justify-between items-center shrink-0">
                    <div>
                        <span class="text-[9px] bg-nbb-yellow text-black font-bold px-1.5 py-0.5 rounded">세트 구성 2단계</span>
                        <h3 class="text-xs font-bold mt-0.5">음료 교환이 가능합니다</h3>
                    </div>
                    <button onclick="playTouchSound(); closeModal('modalDrinkChoice')" class="text-gray-400 text-lg">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <!-- Drink Options Grid (Photo 7 Style) -->
                <div class="p-2.5 overflow-y-auto flex-1 bg-gray-50">
                    <div class="grid grid-cols-4 gap-1.5 text-center" id="drinkGridContainer">
                        <!-- JS Injected Drink List -->
                    </div>
                </div>

                <!-- Footer Nav -->
                <div class="p-2.5 bg-gray-100 flex gap-2 shrink-0 border-t border-gray-200">
                    <button onclick="playTouchSound(); openModal('modalBurgerChoice'); closeModal('modalDrinkChoice');" class="w-1/3 bg-gray-300 font-bold text-xs py-2 rounded-xl text-gray-700">
                        이전
                    </button>
                    <button onclick="playTouchSound(); confirmComboToCart()" class="w-2/3 bg-red-600 font-black text-xs py-2 text-white rounded-xl shadow">
                        장바구니 담기 완료
                    </button>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- MODAL 4: CHECKOUT & PAYMENT SIMULATOR -->
        <!-- ========================================== -->
        <div id="checkoutModal" class="hidden absolute inset-0 z-40 bg-black/80 flex flex-col justify-end">
            <div class="bg-white rounded-t-3xl h-[85%] flex flex-col overflow-hidden shadow-2xl">
                
                <div class="p-3 bg-neutral-900 text-white flex justify-between items-center">
                    <h3 class="text-sm font-bold flex items-center gap-2">
                        <i class="fa-solid fa-credit-card text-nbb-yellow"></i> 주문 확인 및 결제
                    </h3>
                    <button onclick="playTouchSound(); closeModal('checkoutModal')" class="text-gray-400 hover:text-white text-lg">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <!-- Order List Review -->
                <div class="p-3 overflow-y-auto flex-1 divide-y divide-gray-100" id="checkoutOrderSummary">
                    <!-- JS Injected -->
                </div>

                <!-- Total Display & Pay Button -->
                <div class="p-3 bg-gray-50 border-t border-gray-200">
                    <div class="flex justify-between items-center mb-2.5">
                        <span class="text-xs font-bold text-gray-600">최종 결제 금액</span>
                        <span class="text-xl font-black text-red-600" id="checkoutFinalPrice">0 원</span>
                    </div>

                    <button onclick="playTouchSound(); processPayment()" class="touch-active w-full bg-nbb-yellow text-nbb-black font-black text-base py-3 rounded-2xl shadow-xl flex items-center justify-center gap-2">
                        <i class="fa-solid fa-lock"></i>
                        <span>신용카드 결제하기</span>
                    </button>
                </div>
            </div>
